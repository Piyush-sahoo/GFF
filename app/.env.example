# Copy this file to `.env` in this same directory and fill in real values.
# `.env` is git-ignored and its contents are never printed to logs or session output.
#
#   cp .env.example .env && $EDITOR .env
#
# Next.js loads `.env` automatically for `next dev`, `next build`, and `next start`.

# --- Required for /api/chat ---------------------------------------------------
# Google Gemini API key: https://aistudio.google.com/apikey
# Without it, /api/chat returns HTTP 503 with a clear message instead of guessing.
# Model: gemini-3.6-flash (override with GEMINI_MODEL).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- Required for live partner data -------------------------------------------
# MongoDB Atlas SRV connection string, e.g.
#   mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# URL-encode any special characters in the password (@ -> %40, # -> %23, / -> %2F).
# When unset, the app serves clearly-labelled sample fixtures and shows a
# "Sample data" banner on the homepage.
MONGODB_URI=

# Database name holding the `partners` and `speakers` collections. Defaults to "gff".
MONGODB_DB=gff

# --- Required for deployment only (not read by the app) -----------------------
# Vercel access token: https://vercel.com/account/settings/tokens
# Used by ./deploy.sh to create the project, push env vars, and deploy to prod.
VERCEL_TOKEN=
