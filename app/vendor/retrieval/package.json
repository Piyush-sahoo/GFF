{
  "name": "@gff/retrieval",
  "version": "0.1.0",
  "description": "Hybrid retrieval and ranking for the GFF 2026 attendee chatbot",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./corpus": "./data/corpus.jsonl"
  },
  "files": [
    "src",
    "data"
  ],
  "sideEffects": false,
  "scripts": {
    "build:corpus": "tsx scripts/build-corpus.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
