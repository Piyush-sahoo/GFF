# Copy to .env in this same directory and fill in the real value.
# Owner of the Atlas cluster: worker scratch-2. This worker (scratch-4) only reads
# this URI and performs idempotent upserts — it never creates clusters, users or
# access-list entries, and never drops a collection.
#
# Format: mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# URL-encode any special characters in the password (@ -> %40, # -> %23, / -> %2F).
MONGODB_URI=

# Optional overrides (defaults shown)
MONGODB_DB=gff

# Apify token for partner/exhibitor company enrichment (scratch-4)
APIFY_TOKEN=
